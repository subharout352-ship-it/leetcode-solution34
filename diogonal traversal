class Solution(object):
    def findDiagonalOrder(self, mat):
        """
        :type mat: List[List[int]]
        :rtype: List[int]
        """
        if not mat or not mat[0]:
            return []

        m = len(mat)
        n = len(mat[0])

        result = []

        for d in range(m + n - 1):
            temp = []

            r = 0 if d < n else d - n + 1
            c = d if d < n else n - 1

            while r < m and c >= 0:
                temp.append(mat[r][c])
                r += 1
                c -= 1

            if d % 2 == 0:
                result.extend(temp[::-1])
            else:
                result.extend(temp)

        return result
